value Unit() {
    intrinsic type none
    operator fun `==`(other: Unit): Boolean = intrinsic
    operator fun `!=`(other: Unit): Boolean = intrinsic
}

value Boolean() {
    intrinsic type i32
    operator fun `==`(other: Boolean): Boolean = intrinsic i32.eq(this, other)
    operator fun `!=`(other: Boolean): Boolean = intrinsic i32.ne(this, other)
    operator fun `prefix !`(): Boolean = intrinsic i32.eqz(this)
}

value String() {
    operator fun `+`(other: String): String = intrinsic
    operator fun `==`(other: String): Boolean = intrinsic
    operator fun `!=`(other: String): Boolean = intrinsic
}

value Null() {
    intrinsic type i32
    operator fun `==`(other: Null): Boolean = intrinsic
    operator fun `!=`(other: Null): Boolean = intrinsic
}

value i32() {
    intrinsic type i32
    operator fun `prefix +`(): i32 = this
    operator fun `prefix -`(): i32 = intrinsic i32.sub(0, this)
    operator fun `+`(other: i32): i32 = intrinsic i32.add(this, other)
    operator fun `-`(other: i32): i32 = intrinsic i32.sub(this, other)
    operator fun `*`(other: i32): i32 = intrinsic i32.mul(this, other)
    operator fun `/`(other: i32): i32 = intrinsic i32.div_s(this, other)
    operator fun `%`(other: i32): i32 = intrinsic i32.rem_s(this, other)

    operator fun `<`(other: i32): Boolean = intrinsic i32.lt_s(this, other)
    operator fun `<=`(other: i32): Boolean = intrinsic i32.le_s(this, other)
    operator fun `>`(other: i32): Boolean = intrinsic i32.gt_s(this, other)
    operator fun `>=`(other: i32): Boolean = intrinsic i32.ge_s(this, other)

    operator fun `==`(other: i32): Boolean = intrinsic i32.eq(this, other)
    operator fun `!=`(other: i32): Boolean = intrinsic i32.ne(this, other)

    fun countLeadingZeros(): i32 = intrinsic i32.clz(this)
    fun countTrailingZeros(): i32 = intrinsic i32.ctz(this)
    fun countNonZeroBits(): i32 = intrinsic i32.popcnt(this)
}

value i64() {
    intrinsic type i64
    operator fun `prefix +`(): i64 = this
    operator fun `prefix -`(): i64 = intrinsic i64.sub(0 as i64, this)
    operator fun `+`(other: i64): i64 = intrinsic i64.add(this, other)
    operator fun `-`(other: i64): i64 = intrinsic i64.sub(this, other)
    operator fun `*`(other: i64): i64 = intrinsic i64.mul(this, other)
    operator fun `/`(other: i64): i64 = intrinsic i64.div_s(this, other)
    operator fun `%`(other: i64): i64 = intrinsic i64.rem_s(this, other)

    operator fun `<`(other: i64): Boolean = intrinsic i64.lt_s(this, other)
    operator fun `<=`(other: i64): Boolean = intrinsic i64.le_s(this, other)
    operator fun `>`(other: i64): Boolean = intrinsic i64.gt_s(this, other)
    operator fun `>=`(other: i64): Boolean = intrinsic i64.ge_s(this, other)

    operator fun `==`(other: i64): Boolean = intrinsic i64.eq(this, other)
    operator fun `!=`(other: i64): Boolean = intrinsic i64.ne(this, other)

    fun countLeadingZeros(): i64 = intrinsic
    fun countTrailingZeros(): i64 = intrinsic
    fun countNonZeroBits(): i64 = intrinsic
}

value f32() {
    intrinsic type f32
    operator fun `prefix +`(): f32 = intrinsic
    operator fun `prefix -`(): f32 = intrinsic f32.neg(this)
    operator fun `+`(other: f32): f32 = intrinsic f32.add(this, other)
    operator fun `-`(other: f32): f32 = intrinsic f32.sub(this, other)
    operator fun `*`(other: f32): f32 = intrinsic f32.mul(this, other)
    operator fun `/`(other: f32): f32 = intrinsic f32.div(this, other)
    operator fun `<`(other: f32): Boolean = intrinsic f32.lt(this, other)
    operator fun `<=`(other: f32): Boolean = intrinsic f32.le(this, other)
    operator fun `>`(other: f32): Boolean = intrinsic f32.gt(this, other)
    operator fun `>=`(other: f32): Boolean = intrinsic f32.ge(this, other)

    operator fun `==`(other: f32): Boolean = intrinsic f32.eq(this, other)
    operator fun `!=`(other: f32): Boolean = intrinsic f32.ne(this, other)

    fun abs(): f32 = intrinsic
    fun ceil(): i32 = intrinsic
    fun floor(): i32 = intrinsic
    fun max(other: f32): f32 = intrinsic
    fun min(other: f32): f32 = intrinsic
    fun sqrt(): f32 = intrinsic
}

value f64() {
    intrinsic type f64
    operator fun `prefix +`(): f64 = intrinsic
    operator fun `prefix -`(): f64 = intrinsic f64.neg(this)
    operator fun `+`(other: f64): f64 = intrinsic f64.add(this, other)
    operator fun `-`(other: f64): f64 = intrinsic f64.sub(this, other)
    operator fun `*`(other: f64): f64 = intrinsic f64.mul(this, other)
    operator fun `/`(other: f64): f64 = intrinsic f64.div(this, other)

    operator fun `<`(other: f64): Boolean = intrinsic f64.lt(this, other)
    operator fun `<=`(other: f64): Boolean = intrinsic f64.le(this, other)
    operator fun `>`(other: f64): Boolean = intrinsic f64.gt(this, other)
    operator fun `>=`(other: f64): Boolean = intrinsic f64.ge(this, other)

    operator fun `==`(other: f64): Boolean = intrinsic f64.eq(this, other)
    operator fun `!=`(other: f64): Boolean = intrinsic f64.ne(this, other)

    fun abs(): f64 = intrinsic
    fun ceil(): i32 = intrinsic
    fun floor(): i32 = intrinsic
    fun max(other: f64): f64 = intrinsic
    fun min(other: f64): f64 = intrinsic
    fun sqrt(): f64 = intrinsic
}
