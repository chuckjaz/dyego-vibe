value Unit() {
    intrinsic type none
    operator fun `==`(other: Unit): Boolean = intrinsic
    operator fun `!=`(other: Unit): Boolean = intrinsic
}

value Boolean() {
    intrinsic type i32
    operator fun `==`(other: Boolean): Boolean = intrinsic
    operator fun `!=`(other: Boolean): Boolean = intrinsic
    operator fun `!`(): Boolean = intrinsic
}

value String() {
    operator fun `+`(other: String): String = intrinsic
    operator fun `==`(other: String): Boolean = intrinsic
    operator fun `!=`(other: String): Boolean = intrinsic
}

value Null() {
    intrinsic type i32
    operator fun `==`(other: Null): Boolean = intrinsic
    operator fun `!=`(other: Null): Boolean = intrinsic
}

value i32() {
    intrinsic type i32
    operator fun `+`(other: i32): i32 = intrinsic
    operator fun `-`(other: i32): i32 = intrinsic
    operator fun `*`(other: i32): i32 = intrinsic
    operator fun `/`(other: i32): i32 = intrinsic
    operator fun `%`(other: i32): i32 = intrinsic

    operator fun `<`(other: i32): Boolean = intrinsic
    operator fun `<=`(other: i32): Boolean = intrinsic
    operator fun `>`(other: i32): Boolean = intrinsic
    operator fun `>=`(other: i32): Boolean = intrinsic

    operator fun `==`(other: i32): Boolean = intrinsic
    operator fun `!=`(other: i32): Boolean = intrinsic

    fun abs(): i32 = intrinsic
    fun countLeadingZeros(): i32 = intrinsic
    fun countTrailingZeros(): i32 = intrinsic
    fun countNonZeroBits(): i32 = intrinsic
    fun inv(): i32 = intrinsic
    fun max(other: i32): i32 = intrinsic
    fun min(other: i32): i32 = intrinsic
}

